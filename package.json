{
  "name": "groundwork",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:agent": "eve dev --agent assistant --no-default-extensions",
    "dev:photon": "eve dev --agent assistant --no-ui --no-default-extensions --port 4311",
    "build": "node scripts/build.mjs",
    "check:words": "node scripts/check-words.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --import ./scripts/test-env.ts --test 'agents/**/*.test.ts' 'core/**/*.test.ts' 'scripts/**/*.test.ts' 'lib/**/*.test.ts'",
    "test:db": "BLOB_LOCAL_DIR= node --env-file=.env.local --import tsx --import ./scripts/test-env.ts --test --test-concurrency=1 'agents/**/*.test.ts' 'core/**/*.test.ts' 'scripts/**/*.test.ts' 'lib/**/*.test.ts'",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "node scripts/migration-check.mjs",
    "provision": "node --env-file-if-exists=.env.local node_modules/.bin/tsx scripts/provision.ts",
    "admin:create": "node --env-file-if-exists=.env.local node_modules/.bin/tsx scripts/admin-create.ts",
    "evals": "IMESSAGE_FAKE=1 PHOTON_ADMIN_FAKE=1 IMESSAGE_PROJECT_ID= IMESSAGE_PROJECT_SECRET= RESEND_API_KEY= EMAIL_FROM= EMAIL_FAKE=1 STRIPE_FAKE=1 STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET= AGENTMAIL_FAKE=1 AGENTMAIL_API_KEY= AGENTMAIL_WEBHOOK_SECRET= eve eval --agent assistant",
    "photon:webhook": "node --env-file-if-exists=.env.local node_modules/.bin/tsx scripts/photon-webhook.ts",
    "email:inbox": "node --env-file-if-exists=.env.local node_modules/.bin/tsx scripts/email-inbox.ts",
    "email:fake": "node --env-file-if-exists=.env.local node_modules/.bin/tsx scripts/email-fake.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@agent-browser/eve": "0.39.2",
    "@ai-sdk/azure": "^4.0.110",
    "@base-ui/react": "1.8.0",
    "@chat-adapter/state-memory": "4.43.0",
    "@pdf-lib/upng": "1.0.1",
    "@photon-ai/chat-adapter-imessage": "3.2.0",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@spectrum-ts/imessage": "10.0.0",
    "@streamdown/cjk": "1.0.4",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "@streamdown/mermaid": "1.0.3",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.153",
    "better-auth": "1.7.5",
    "chat": "4.43.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "^0.45.3",
    "eve": "0.83.2",
    "glimm": "0.3.1",
    "heic-decode": "2.1.0",
    "iconoir-react": "7.12.1",
    "jpeg-js": "0.4.4",
    "liveline": "0.0.7",
    "loading-dev": "0.3.4",
    "lucide-react": "1.52.0",
    "mailauth": "5.0.3",
    "marked": "18.1.0",
    "motion": "14.0.0",
    "nanoid": "6.0.2",
    "next": "16.3.8",
    "parse5": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.21.2",
    "shadow-plugin": "2.1.1",
    "shiki": "4.5.0",
    "streamdown": "2.7.0",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "5.0.68",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "mailauth": {
      "nodemailer": "10.1.7",
      "joi": "18.2.9"
    }
  }
}
