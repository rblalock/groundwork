# Postgres, the app's one database for every business. Locally, a Postgres of your own.
DATABASE_URL=

# Meta Model API. META_MODEL_API_KEY is required. MODEL_ID defaults to muse-wonder-1.0.
META_MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-wonder-1.0
MODEL_FALLBACK_ID=muse-spark-1.3
# MODEL_USE_FALLBACK=1
# MODEL_REASONING_EFFORT=medium
# MODEL_CONTEXT_TOKENS=200000
# MODEL_API=chat
# SAM_MODEL_ID=sam-3.1
# DESIGNER_ENABLED=1
# VERTICAL=landscaping
# EVAL_MODEL_ID=muse-spark-1.3
# EVAL_JUDGE_MODEL_ID=muse-wonder-1.0

# Optional. Usage: list prices for cost estimates (JSON, USD per million tokens, keyed by model id),
# and the app-wide default limits per business.
# MODEL_PRICES={"muse-wonder-1.0":{"input":4,"cachedInput":0.2,"cacheWrite":0.2,"output":20}}
# USAGE_HOURLY_TURNS=60
# USAGE_HOURLY_OUTPUT_TOKENS=150000
# USAGE_CONCURRENT_TURNS=3
# USAGE_TURN_OUTPUT_RESERVE=8000

# Photon iMessage and Vercel Blob. Set each by hand on the Vercel project.
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=

# Emailing quotes to customers, through Resend. EMAIL_FROM is an address on a domain verified there.
# Without them, the agent tells members to forward the PDF. EMAIL_FAKE=1 records instead of sending.
RESEND_API_KEY=
EMAIL_FROM=

# Card payments on invoices, through Stripe Connect (each business connects its own Standard account).
# STRIPE_WEBHOOK_SECRET is the signing secret of the Connect webhook at /api/webhooks/stripe. Without
# them, invoices go out without a pay link. STRIPE_FAKE=1 (dev only, never production) stands in for
# Stripe locally with no keys; tests and evals always use it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_FAKE=1

# Email intake: members forward emails to their business's AgentMail inbox. AGENTMAIL_WEBHOOK_SECRET is the
# signing secret (whsec_…) of the webhook at /api/webhooks/agentmail. Senders are verified on the raw message
# (DKIM and DMARC, against DNS). AGENTMAIL_FAKE=1 (dev only, never production) stands in for AgentMail locally
# with no keys; tests and evals always use it.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Hosts besides cdn.agentmail.to that its download URLs may use, exact, comma-separated; only ones seen on a real account.
# AGENTMAIL_DOWNLOAD_HOSTS=
# AGENTMAIL_FAKE=1

# Placing addresses for drive times, through the US Census geocoder (no key). Locally, unset is the fake: the
# seeded addresses get made-up points and nothing is asked over the network. PLACES_FAKE=0 asks the real one
# locally; on Vercel it's always the real one, and production ignores PLACES_FAKE=1.
# PLACES_FAKE=1

# The forecast for the weather check, from api.weather.gov (no key; it asks for a contact in the User-Agent).
# Locally, unset is the fake: dry, with rain 10 AM-2 PM tomorrow so a demo shows a proposal. WEATHER_FAKE=0 asks
# the real one locally; on Vercel it's always the real one, and production ignores WEATHER_FAKE=1.
# WEATHER_CONTACT=ops@example.com
# WEATHER_FAKE=1

# Local dev only: save quote and invoice PDFs to this folder (absolute path) instead of Vercel Blob.
# BLOB_LOCAL_DIR=

# The web app's sign-in (Better Auth). BETTER_AUTH_SECRET: `openssl rand -hex 32`. BETTER_AUTH_URL is the
# app's public URL (defaults to http://localhost:3000 locally, and the Vercel URL on Vercel).
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
# Super admins are made only with `npm run admin:create -- <email>`, and only for an email on
# SUPER_ADMIN_EMAILS; there is no web sign-up.
# SUPER_ADMIN_EMAILS=

# Local dev only: print sign-in codes to the server console (LOGIN_CODE_LOG=1), print iMessage posts
# instead of sending them (IMESSAGE_FAKE=1), and provision without real Photon credentials (PHOTON_ADMIN_FAKE=1).
# LOGIN_CODE_LOG=1
# IMESSAGE_FAKE=1
# PHOTON_ADMIN_FAKE=1
